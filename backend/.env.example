# Copy to backend/.env and fill in. SECRET_KEY has no default — the app will
# refuse to start without it.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/coverline

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# In DEBUG the OTP is returned in the API response (helpful for testing).
# MUST be false in production.
DEBUG=true

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@covershift.in
EMAIL_FROM_NAME=Covershift

# Comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ── Push Notifications ────────────────────────────────────────────────────────
# Expo Push — optional; leave blank in development, add in production.
EXPO_ACCESS_TOKEN=

# VAPID keys for Web Push (admin browser notifications).
# Generate: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('PRIVATE:', v.private_key_str); print('PUBLIC:', v.public_key_str)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@coverline.in
